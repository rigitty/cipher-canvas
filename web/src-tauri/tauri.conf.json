{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cipher Canvas",
  "version": "1.0.0",
  "identifier": "com.ciphercanvas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cipher Canvas",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../dist/cipher-engine.exe"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns"
    ]
  }
}